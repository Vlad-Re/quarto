@startuml turn-sequence
title Quarto v1.0 — player turn and bot reply

actor Player
participant "View" as View
participant "Presenter" as Presenter
participant "Model" as Model
participant "Bot" as Bot

Player -> View : click empty cell
View -> Presenter : cell clicked
Presenter -> Model : place(state, cell)
Model --> Presenter : new state
Presenter -> View : show state

Player -> View : click piece
View -> Presenter : piece clicked
Presenter -> View : show frame

Player -> View : click same piece again
View -> Presenter : piece clicked
Presenter -> Model : give(state, piece)
Model --> Presenter : new state
Presenter -> View : status "Bot's turn"

Presenter -> Bot : bot(state)
Bot --> Presenter : Move(cell, piece)
Presenter -> View : schedule(BOT_MOVE_DELAY)
View --> Presenter : timer fired
Presenter -> Model : place, then give
Model --> Presenter : new state
Presenter -> View : show state, "Player's turn"
@enduml
