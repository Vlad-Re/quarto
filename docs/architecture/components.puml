' made with AI
@startuml components
title Quarto v1.0 — components

package "Imperative shell" {
  component "View (tkinter)" as View
  component "Presenter" as Presenter
}

package "Functional core" {
  component "Bot" as Bot {
    component "Search algorithms\n(random, greedy, minimax)" as Search
    component "Evaluation function" as Eval
  }
  component "Model" as Model
}

View --> Presenter : clicks, reset
Presenter --> View : what to show
Presenter --> Search : game state
Presenter --> Model : moves
Search --> Eval : score position
Search --> Model : rules (simulation)
Eval --> Model : reads state
@enduml
